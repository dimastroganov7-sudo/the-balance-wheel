<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

  :root {
    --bg-main: #f5f5f7;
    --bg-secondary: #ffffff;
    --glass-bg: rgba(255, 255, 255, 0.72);
    --glass-strong: rgba(255, 255, 255, 0.88);
    --border-soft: rgba(0, 0, 0, 0.06);

    --text-main: #1d1d1f;
    --text-secondary: #6e6e73;

    --accent: #0071e3;
    --accent-light: #5ac8fa;
    --danger: #ff3b30;

    --shadow-soft: 0 8px 30px rgba(0, 0, 0, 0.08);
    --shadow-card: 0 4px 20px rgba(0, 0, 0, 0.06);

    --radius-xl: 30px;
    --radius-lg: 24px;
    --radius-md: 18px;
    --radius-sm: 14px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
  }

  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
      "Segoe UI", Inter, sans-serif;
    background: var(--bg-main);
    color: var(--text-main);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }

  .app {
    max-width: 1360px;
    margin: 0 auto;
    padding: 24px 18px 110px;
  }

  .hero {
    background: var(--glass-bg);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: var(--radius-xl);
    padding: 32px;
    box-shadow: var(--shadow-soft);
    margin-bottom: 24px;
  }

  .hero h1 {
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--text-main);
    margin-bottom: 10px;
  }

  .hero p {
    color: var(--text-secondary);
    font-size: 1rem;
  }

  .toolbar {
    margin-top: 18px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .status-pill {
    background: rgba(0, 113, 227, 0.08);
    color: var(--accent);
    border-radius: 999px;
    padding: 10px 18px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .btn {
    border: none;
    border-radius: 999px;
    padding: 14px 22px;
    background: white;
    color: var(--text-main);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: var(--shadow-card);
  }

  .btn:hover {
    transform: scale(0.98);
  }

  .btn.primary {
    background: var(--accent);
    color: white;
  }

  .btn.warn {
    background: rgba(255, 59, 48, 0.08);
    color: var(--danger);
  }

  .panel {
    display: none;
    background: var(--glass-bg);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border-radius: var(--radius-xl);
    padding: 28px;
    box-shadow: var(--shadow-soft);
    margin-bottom: 20px;
  }

  .panel.active {
    display: block;
    animation: fadeIn 0.25s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  h2 {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 18px;
  }

  h3 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 14px;
  }

  .card,
  .sector-card,
  .task-item,
  .contact-item,
  .chat-item {
    background: var(--glass-strong);
    backdrop-filter: blur(20px);
    border-radius: var(--radius-lg);
    padding: 22px;
    box-shadow: var(--shadow-card);
    border: 1px solid rgba(255, 255, 255, 0.7);
  }

  .sector-card:hover,
  .contact-item:hover,
  .chat-item:hover {
    transform: translateY(-2px);
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .sector-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 12px;
    margin-bottom: 14px;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: none;
    background: rgba(242, 242, 247, 0.95);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    font-size: 16px;
    color: var(--text-main);
    font-family: inherit;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid rgba(0, 113, 227, 0.25);
  }

  .badge {
    background: rgba(0, 113, 227, 0.08);
    color: var(--accent);
    border-radius: 999px;
    padding: 8px 14px;
    font-weight: 600;
    display: inline-block;
  }

  .calendar {
    width: 100%;
    border-collapse: separate;
    border-spacing: 8px;
  }

  .calendar th,
  .calendar td {
    background: white;
    border-radius: 14px;
    padding: 12px;
    text-align: center;
    box-shadow: var(--shadow-card);
  }

  .progress-wrap {
    height: 10px;
    border-radius: 999px;
    background: #e5e5ea;
    overflow: hidden;
  }

  .progress {
    height: 100%;
    width: 0;
    background: var(--accent);
    border-radius: 999px;
  }

  .modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(18px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 20px;
  }

  .modal.active {
    display: flex;
  }

  .modal-box {
    width: 100%;
    max-width: 900px;
    max-height: 90vh;
    overflow: auto;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(30px);
    border-radius: 32px;
    padding: 28px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
  }

  .bottom-nav {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 16px;

    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(30px) saturate(180%);
    -webkit-backdrop-filter: blur(30px) saturate(180%);

    border-radius: 28px;

    padding: 14px 18px;

    display: flex;
    justify-content: space-around;

    box-shadow: var(--shadow-soft);

    z-index: 100;
  }

  .nav-item {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-weight: 500;
    cursor: pointer;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .nav-item.active {
    color: var(--accent);
    font-weight: 600;
  }

  .nav-icon {
    font-size: 1.8rem;
  }

  .meta {
    color: var(--text-secondary);
  }

  @media (max-width: 800px) {
    .grid-2 {
      grid-template-columns: 1fr;
    }

    .app {
      padding: 16px 12px 100px;
    }

    .hero h1 {
      font-size: 2rem;
    }
  }
</style>