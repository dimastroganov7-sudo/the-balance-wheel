    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap');

    :root {
      --bg-light: #f5f5f7;
      --card-bg: #ffffff;
      --card-border: rgba(60, 60, 67, 0.06);
      --text-primary: #1c1c1e;
      --text-secondary: #8e8e93;
      --accent-blue: #007aff;
      --accent-green: #34c759;
      --accent-orange: #ff9f0a;
      --accent-red: #ff3b30;
      --separator: #c6c6c8;
      --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.04), 0 0 0 0.5px rgba(0, 0, 0, 0.02);
      --shadow-md: 0 8px 20px rgba(0, 0, 0, 0.06), 0 0 0 0.5px rgba(0, 0, 0, 0.02);
      --radius-card: 18px;
      --radius-btn: 12px;
      --font-sans: 'Manrope', -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      margin: 0;
      color: var(--text-primary);
      font-family: var(--font-sans);
      background: var(--bg-light);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    .app { max-width: 1280px; margin: 0 auto; padding: 24px 18px 80px; }

    .hero {
      background: var(--card-bg);
      border-radius: var(--radius-card);
      padding: 24px;
      color: var(--text-primary);
      box-shadow: var(--shadow-md);
      border: 0.5px solid var(--card-border);
      margin-bottom: 16px;
    }

    .hero h1 {
      margin: 0 0 6px;
      font-size: clamp(1.4rem, 2.4vw, 2rem);
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .hero p { color: var(--text-secondary); margin: 8px 0 12px; }

    .toolbar { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 10px; }

    .status-pill {
      background: rgba(120, 120, 128, 0.08);
      border-radius: 40px;
      padding: 8px 14px;
      font-size: 0.86rem;
      color: var(--text-secondary);
      font-weight: 500;
      border: none;
      backdrop-filter: blur(8px);
    }

    .btn {
      border: none;
      background: rgba(120, 120, 128, 0.08);
      border-radius: var(--radius-btn);
      padding: 10px 16px;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.94rem;
      color: var(--text-primary);
      transition: all 0.15s ease;
      font-family: var(--font-sans);
      backdrop-filter: blur(8px);
    }

    .btn.primary {
      background: var(--accent-blue);
      color: white;
    }

    .btn.warn {
      background: rgba(255, 59, 48, 0.12);
      color: var(--accent-red);
    }

    .tabs { display: flex; gap: 8px; flex-wrap: wrap; margin: 18px 0; }

    .tab-btn {
      border: none;
      background: rgba(120, 120, 128, 0.08);
      border-radius: 40px;
      padding: 10px 18px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .tab-btn.active {
      background: var(--accent-blue);
      color: white;
    }

    .panel {
      display: none;
      background: var(--card-bg);
      border-radius: var(--radius-card);
      box-shadow: var(--shadow-md);
      padding: 20px;
      border: 0.5px solid var(--card-border);
      backdrop-filter: blur(4px);
    }

    .panel.active { display: block; animation: fade 0.2s ease; }

    @keyframes fade { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

    h2 { margin: 0 0 14px; font-size: 1.4rem; font-weight: 700; }
    h3 { margin: 0 0 10px; font-size: 1.1rem; font-weight: 600; }

    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

    .card {
      background: var(--card-bg);
      border-radius: 16px;
      padding: 16px;
      border: 0.5px solid var(--card-border);
      box-shadow: var(--shadow-sm);
    }

    .sector-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }

    .sector-card {
      text-align: left;
      border: 0.5px solid var(--card-border);
      background: var(--card-bg);
      border-radius: 16px;
      padding: 14px;
      cursor: pointer;
      transition: all 0.15s;
      box-shadow: var(--shadow-sm);
    }

    .sector-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }

    .meta { color: var(--text-secondary); font-size: 0.88rem; }

    .level-legend { margin-top: 16px; border-collapse: collapse; width: 100%; font-size: 0.88rem; }
    .level-legend td, .level-legend th { border: 0.5px solid var(--separator); padding: 10px; background: var(--card-bg); }

    .form-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; margin-bottom: 10px; }

    input, select, textarea {
      width: 100%;
      border: 0.5px solid var(--separator);
      border-radius: 12px;
      padding: 12px;
      font-family: var(--font-sans);
      font-size: 0.94rem;
      background: var(--card-bg);
      color: var(--text-primary);
    }

    .list { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }

    .list-item {
      border: 0.5px solid var(--card-border);
      border-radius: 14px;
      padding: 12px;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 10px;
      align-items: center;
      background: var(--card-bg);
      box-shadow: var(--shadow-sm);
    }

    .matrix-layout { display: grid; grid-template-columns: 220px 1fr; gap: 16px; }

    .matrix-tabs { display: flex; flex-direction: column; gap: 8px; }

    .matrix-tabs button {
      text-align: left;
      padding: 12px 14px;
      border-radius: 14px;
      border: none;
      background: var(--card-bg);
      font-weight: 600;
      box-shadow: var(--shadow-sm);
    }

    .matrix-tabs button.active { background: var(--accent-blue); color: white; }

    .pane { display: none; }
    .pane.active { display: block; }

    .relations-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    .relations-table th, .relations-table td { border: 0.5px solid var(--separator); padding: 10px; background: var(--card-bg); }

    .badge {
      background: rgba(120, 120, 128, 0.1);
      color: var(--text-secondary);
      border-radius: 40px;
      padding: 6px 12px;
      font-size: 0.8rem;
      font-weight: 600;
      display: inline-block;
    }

    .process-item, .task-item {
      border: 0.5px solid var(--card-border);
      border-radius: 16px;
      padding: 14px;
      background: var(--card-bg);
      margin-bottom: 10px;
      box-shadow: var(--shadow-sm);
    }

    .task-item.today { border-left: 4px solid var(--accent-blue); }
    .task-item.overdue { border-left: 4px solid var(--accent-red); }

    .task-head { display: flex; justify-content: space-between; flex-wrap: wrap; align-items: center; }

    .calendar { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    .calendar th, .calendar td {
      border: 0.5px solid var(--separator);
      padding: 8px;
      text-align: left;
      vertical-align: top;
      height: 90px;
      background: var(--card-bg);
      cursor: pointer;
    }

    .dot {
      display: inline-block;
      border-radius: 40px;
      font-size: 0.72rem;
      padding: 3px 10px;
      background: rgba(120, 120, 128, 0.08);
      margin: 4px 0;
    }

    .progress-wrap { width: 100%; height: 10px; border-radius: 40px; background: rgba(120, 120, 128, 0.12); overflow: hidden; }
    .progress { height: 100%; background: var(--accent-blue); width: 0; border-radius: 40px; }

    .modal {
      position: fixed; inset: 0; background: rgba(0,0,0,0.3);
      backdrop-filter: blur(6px);
      display: none; align-items: center; justify-content: center;
      padding: 16px; z-index: 1000;
    }
    .modal.active { display: flex; }
    .modal-box {
      width: min(1040px, 100%); max-height: 92vh; overflow: auto;
      background: var(--card-bg); border-radius: 24px; padding: 20px;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
    }

    .close-row { display: flex; justify-content: flex-end; margin-top: 16px; gap: 10px; }
    .small { font-size: 0.82rem; color: var(--text-secondary); }

    .alarm-section { background: rgba(120, 120, 128, 0.04); border-radius: 20px; padding: 18px; margin-top: 20px; }
    .alarm-header { display: flex; justify-content: space-between; align-items: center; font-weight: 600; margin-bottom: 16px; }
    .add-btn { background: var(--accent-blue); border: none; width: 44px; height: 44px; border-radius: 40px; color: white; font-size: 28px; cursor: pointer; }
    .alarm-list { display: flex; flex-direction: column; gap: 12px; }
    .alarm-item { background: var(--card-bg); border-radius: 18px; padding: 14px; display: flex; justify-content: space-between; align-items: center; box-shadow: var(--shadow-sm); }
    .alarm-info { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .alarm-time { font-size: 20px; font-weight: 700; }
    .day-badge { width: 36px; text-align: center; font-size: 12px; padding: 5px 0; border-radius: 40px; background: rgba(120,120,128,0.1); display: inline-block; margin: 0 2px; }
    .day-badge.active { background: var(--accent-blue); color: white; }
    .mission-badge, .snooze-badge { background: rgba(120,120,128,0.1); border-radius: 40px; padding: 4px 10px; font-size: 12px; }

    .weather-map-row { display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 20px; }
    .weather-card { flex: 1.2; min-width: 220px; background: var(--card-bg); border-radius: 24px; padding: 18px; box-shadow: var(--shadow-md); }
    .map-container { flex: 2; min-width: 260px; background: var(--card-bg); border-radius: 24px; padding: 14px; box-shadow: var(--shadow-md); }
    #map { height: 280px; width: 100%; border-radius: 20px; z-index: 1; }

    .gear-icon { cursor: pointer; font-size: 1.5rem; transition: transform 0.2s; color: var(--accent-blue); }
    .gear-icon:hover { transform: rotate(30deg); }

    .character-settings { display: flex; flex-direction: column; gap: 20px; }
    .crop-preview { display: flex; gap: 20px; flex-wrap: wrap; align-items: center; }
    .preview-canvas { border: 2px solid rgba(120,120,128,0.2); border-radius: 50%; overflow: hidden; width: 120px; height: 120px; background: var(--bg-light); }
    .preview-canvas canvas { width: 100%; height: 100%; object-fit: cover; }
    .sliders { flex: 1; min-width: 200px; }
    .slider-group { margin-bottom: 16px; }
    input[type="range"] { width: 100%; accent-color: var(--accent-blue); }

    .bottom-nav {
      position: fixed; bottom: 0; left: 0; right: 0;
      background: rgba(255,255,255,0.85); backdrop-filter: blur(20px);
      border-top: 0.5px solid var(--separator);
      display: flex; justify-content: space-around;
      padding: 10px 16px 16px; z-index: 100;
    }
    .nav-item {
      display: flex; flex-direction: column; align-items: center;
      background: none; border: none; cursor: pointer;
      color: var(--text-secondary); font-weight: 500;
    }
    .nav-item.active { color: var(--accent-blue); }
    .nav-icon { font-size: 1.7rem; }
    .nav-label { font-size: 0.7rem; }

    .settings-subtabs { display: flex; gap: 8px; margin-bottom: 24px; }
    .settings-subtab {
      background: none; border: none; padding: 8px 18px;
      border-radius: 40px; font-weight: 600; color: var(--text-secondary);
    }
    .settings-subtab.active { background: var(--accent-blue); color: white; }
    .settings-pane { display: none; }
    .settings-pane.active { display: block; }

    .contacts-header, .chats-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .search-container { position: relative; margin-bottom: 16px; }
    .search-container input { padding-left: 44px; }
    .search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-size: 1.2rem; color: var(--text-secondary); }
    .contact-list, .chat-list { display: flex; flex-direction: column; gap: 8px; max-height: 60vh; overflow-y: auto; }
    .contact-item, .chat-item {
      display: flex; align-items: center; gap: 14px; padding: 12px;
      background: var(--card-bg); border-radius: 18px;
      border: 0.5px solid var(--card-border); cursor: pointer;
    }
    .contact-avatar, .chat-avatar {
      width: 48px; height: 48px; border-radius: 50%;
      background: rgba(120,120,128,0.1); display: flex;
      align-items: center; justify-content: center; font-size: 1.5rem;
    }
    .contact-name { font-weight: 700; }
    .chat-messages { height: 50vh; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; padding: 8px; background: var(--bg-light); border-radius: 20px; }
    .message { max-width: 70%; padding: 10px 14px; border-radius: 20px; }
    .message.outgoing { align-self: flex-end; background: var(--accent-blue); color: white; }
    .message.incoming { align-self: flex-start; background: var(--card-bg); border: 0.5px solid var(--card-border); }
    .chat-input-area { display: flex; gap: 10px; margin-top: 14px; }
  </style>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
</head>
<body>
<main class="app">
  <section class="hero">
    <h1>Годовая настройка и процессы</h1>
    <p>8 секторов · X-матрица · аналитика</p>
    <div class="toolbar">
      <span class="status-pill" id="saveStateLabel">Статус: синхронизация...</span>
      <button class="btn" id="syncNowBtn" type="button">Синхронизировать</button>
    </div>
  </section>

  <section class="panel" id="panel-tasks">
    <h2>Задачи по дням</h2>
    <div class="form-row"><div><label>Дата</label><input id="taskDateFilter" type="date" /></div><div><label>Оставшееся время (мин.)</label><input id="freeTimeInput" type="number" min="0" value="90" /></div></div>
    <div class="card"><h3>Создать функцию на день</h3><div class="form-row"><input id="quickTaskTitle" placeholder="Название" /><select id="quickTaskSector"></select><input id="quickTaskMinutes" type="number" min="5" value="30" /><select id="quickTaskInfluence"></select><button class="btn primary" id="createQuickTaskBtn">Добавить</button></div></div>
    <div id="tasksContainer"></div>
  </section>

  <section class="panel" id="panel-analytics">
    <h2>Календарь и прогресс</h2>
    <div class="weather-map-row">
      <div class="weather-card" id="weatherWidget">
        <div>📍 Москва</div>
        <div class="weather-main"><span class="weather-temp" id="weatherTemp">--°</span><span id="weatherIcon">⛅</span></div>
        <div id="weatherDesc">загрузка...</div>
        <div id="weatherDetails"></div>
        <a href="https://yandex.ru/pogoda/ru/moscow" target="_blank" style="color:var(--accent-blue);">Яндекс.Погода →</a>
      </div>
      <div class="map-container">
        <h4>🗺️ Карта <span class="gear-icon" id="openCharSettingsBtn" title="Настройка персонажа">⚙️</span></h4>
        <div id="map"></div>
      </div>
    </div>
    <div class="form-row"><button class="btn" id="prevMonthBtn">←</button><span id="calendarMonthLabel" class="badge"></span><button class="btn" id="nextMonthBtn">→</button></div>
    <div style="overflow-x:auto;"><table class="calendar"><thead id="calendarHead"></thead><tbody id="calendarBody"></tbody></table></div>
    <div class="card"><h3>Аналитика</h3><div class="form-row"><div><label>От</label><input id="analyticsFrom" type="date" /></div><div><label>До</label><input id="analyticsTo" type="date" /></div><button class="btn" id="runAnalyticsBtn">Рассчитать</button></div><div id="analyticsText" class="meta"></div><div class="progress-wrap"><div id="analyticsProgress" class="progress"></div></div></div>
  </section>

  <section class="panel" id="panel-settings">
    <div class="settings-subtabs">
      <button class="settings-subtab active" data-subtab="year">Год</button>
      <button class="settings-subtab" data-subtab="personality">Личность</button>
      <button class="settings-subtab" data-subtab="processes">Процессы</button>
    </div>
    <div id="settings-year" class="settings-pane active">
      <h2>Сектора года</h2>
      <div id="sectorCards" class="sector-grid"></div>
      <table class="level-legend"><thead><tr><th>Уровень</th><th>Значок</th></tr></thead><tbody id="influenceLegendBody"></tbody></table>
      <div class="card" style="margin-top:16px;"><h3>Взаимосвязи</h3><table class="relations-table"><thead><tr><th>№</th><th>Что</th><th>С чем</th></tr></thead><tbody><tr><td>1</td><td>Результаты</td><td>Стратегии</td></tr><tr><td>2</td><td>Стратегии</td><td>Тактика</td></tr><tr><td>3</td><td>Тактика</td><td>Процесс/Проект</td></tr><tr><td>4</td><td>Процесс/Проект</td><td>Результаты</td></tr><tr><td>5</td><td>Исполнитель</td><td>Результаты</td></tr></tbody></table></div>
    </div>
    <div id="settings-personality" class="settings-pane">
      <h2>Антропометрия и тесты</h2>
      <div class="grid-2">
        <div class="card"><h3>Параметры InBody</h3><div id="anthroForm" class="form-row"></div><button class="btn primary" id="saveAnthroBtn">Сохранить</button></div>
        <div class="card"><h3>Психологическое тестирование</h3><div id="testForm"></div><div id="testSummary" class="badge"></div></div>
      </div>
      <div class="card"><h3>Анализы</h3><div id="analysisList" class="list"></div><div class="form-row"><input id="analysisName" placeholder="Название" /><input id="analysisValue" placeholder="Значение" /><input id="analysisDate" type="date" /></div><button class="btn" id="addAnalysisBtn">Добавить</button></div>
      <div class="alarm-section"><div class="alarm-header"><span>⏰ Будильник</span><button id="add-alarm-btn" class="add-btn">+</button></div><div id="alarm-list" class="alarm-list"></div></div>
    </div>
    <div id="settings-processes" class="settings-pane">
      <h2>Процессы</h2>
      <div class="card"><h3>Категории</h3><div id="processCategories" class="list"></div><div class="form-row"><input id="newCategoryInput" placeholder="Новая" /><button class="btn" id="addCategoryBtn">Добавить</button></div></div>
      <div class="card"><h3>Шаблоны</h3><div id="processTemplates" class="list"></div></div>
      <div class="card"><h3>Мои процессы</h3><div id="processItems"></div><button class="btn primary" id="addProcessItemBtn">Добавить</button></div>
      <div class="card"><h3>Генерация календаря</h3><button class="btn" id="generateScheduleBtn">Сформировать на 14 дней</button></div>
    </div>
  </section>

  <section class="panel" id="panel-contacts">
    <div class="contacts-header"><h2>Контакты</h2><div><button class="btn" id="sortContactsBtn">📋</button><button class="btn" id="addContactBtn">➕</button></div></div>
    <div id="sortDropdown" style="display:none;"><button class="btn" data-sort="name">По имени</button><button class="btn" data-sort="lastSeen">По времени</button></div>
    <div class="search-container"><span class="search-icon">🔍</span><input id="contactsSearchInput" placeholder="поиск"><span id="clearContactsSearch" style="position:absolute;right:12px;">✖</span></div>
    <div id="contactsList" class="contact-list"></div>
    <button class="btn primary" id="inviteContactBtn">👥 Пригласить</button>
  </section>

  <section class="panel" id="panel-chats">
    <div class="chats-header"><h2>Чаты</h2><div><button class="btn" id="editChatsBtn">Изм.</button><button class="btn" id="newChatBtn">✏️</button></div></div>
    <div class="search-container"><span class="search-icon">🔍</span><input id="chatsSearchInput" placeholder="поиск"></div>
    <div style="display:flex;gap:12px;margin-bottom:12px;"><button class="btn chat-tab-filter active" data-filter="all">Все</button><button class="btn chat-tab-filter" data-filter="archived">Архив</button></div>
    <div id="chatsList" class="chat-list"></div>
    <div id="chatActionsBar" style="display:none;"><button class="btn" id="markAllReadBtn">Прочитать все</button><button class="btn" id="archiveSelectedBtn">В архив</button><button class="btn warn" id="deleteSelectedBtn">Удалить</button></div>
  </section>
</main>

<div class="modal" id="matrixModal"><div class="modal-box"><h2 id="matrixTitle"></h2><div class="matrix-layout"><div class="matrix-tabs" id="matrixTabs"></div><div id="matrixPanes"></div></div><div class="close-row"><button class="btn" id="closeMatrixBtn">Закрыть</button></div></div></div>
<div class="modal" id="taskModal"><div class="modal-box" style="max-width:760px;"><h2 id="taskModalTitle"></h2><div id="taskModalBody"></div><div class="close-row"><button class="btn" id="markReadBtn">Выйти без заполнения</button><button class="btn" id="closeTaskBtn">Закрыть</button></div></div></div>
<div class="modal" id="characterModal"><div class="modal-box" style="max-width:700px;"><h2>⚙️ Настройка персонажа</h2><div class="character-settings"><div class="crop-preview"><div class="preview-canvas"><canvas id="previewCanvas" width="120" height="120"></canvas></div><div class="sliders"><div class="slider-group"><label>Масштаб</label><input type="range" id="scaleSlider" min="0.5" max="2" step="0.01" value="1"></div><div class="slider-group"><label>Смещение X</label><input type="range" id="offsetXSlider" min="-50" max="50" value="0"></div><div class="slider-group"><label>Смещение Y</label><input type="range" id="offsetYSlider" min="-50" max="50" value="0"></div></div></div><div class="photo-actions"><input type="file" id="photoUploadInput" accept="image/png, image/jpeg"><button class="btn" id="applyPhotoBtn">Применить</button><button class="btn warn" id="removePhotoBtn">Удалить</button></div><div><label><input type="checkbox" id="crystalEnabledCheckbox" checked> Зелёный кристалл</label></div><div class="close-row"><button class="btn primary" id="saveCharacterBtn">Сохранить</button><button class="btn" id="closeCharModalBtn">Отмена</button></div></div></div></div>
<div class="modal" id="contactModal"><div class="modal-box"><div style="display:flex;justify-content:space-between;"><h2>Новый контакт</h2><button class="close-modal-btn">✖</button></div><div class="form-row"><input id="contactFirstName" placeholder="Имя"><input id="contactLastName" placeholder="Фамилия"></div><div class="form-row"><input id="contactCountryCode" placeholder="Код" readonly><input id="contactPhone" placeholder="Телефон"></div><div><label><input type="checkbox" id="syncWithPhone" checked> Синхронизировать</label></div><button class="btn primary" id="saveContactBtn">✔️ Сохранить</button></div></div>
<div class="modal" id="chatModal"><div class="modal-box" style="display:flex;flex-direction:column;height:80vh;"><div style="display:flex;justify-content:space-between;"><button class="close-modal-btn">←</button><h3 id="chatUserName"></h3><div></div></div><div id="chatMessagesArea" class="chat-messages"></div><div class="chat-input-area"><input id="chatMessageInput" placeholder="Сообщение"><button id="sendMessageBtn" class="btn primary">➤</button></div></div></div>

<div class="bottom-nav">
  <button class="nav-item active" data-tab="contacts"><span class="nav-icon">👥</span><span class="nav-label">Контакты</span></button>
  <button class="nav-item" data-tab="chats"><span class="nav-icon">💬</span><span class="nav-label">Чаты</span></button>
  <button class="nav-item" data-tab="tasks"><span class="nav-icon">✅</span><span class="nav-label">Задачи</span></button>
  <button class="nav-item" data-tab="analytics"><span class="nav-icon">📊</span><span class="nav-label">Календарь</span></button>
  <button class="nav-item" data-tab="settings"><span class="nav-icon">⚙️</span><span class="nav-label">Настройка</span></button>
</div>

<script>
// ========== FULL LOGIC (Apple-styled, functional) ==========
const USER_ID = '69d7a4ce59d4646ae0dae714';
const stateEndpoint = `/.netlify/functions/app-state?userId=${encodeURIComponent(USER_ID)}`;
const sectorMeta = [
  { id: 'career_business', title: '🧑‍💼 Карьера / Бизнес' },
  { id: 'finance', title: '💰 Финансы' },
  { id: 'health_fitness', title: '🩺 Здоровье и Фитнес' },
  { id: 'family_friends', title: '👨‍👩‍👧‍👦 Семья и Друзья' },
  { id: 'romantic_relations', title: '❤️ Романтические отношения' },
  { id: 'physical_environment', title: '🏠 Физическое окружение' },
  { id: 'rest_entertainment', title: '🎉 Отдых и Развлечения' },
  { id: 'personal_growth', title: '📚 Личностный рост' }
];
const matrixPanesMeta = [
  { key: 'results', label: '1. Результаты' }, { key: 'strategies', label: '2. Стратегии' },
  { key: 'tactics', label: '3. Тактика' }, { key: 'processProjects', label: '4. Процесс/Проект' }, { key: 'relations', label: '5. Взаимосвязи' }
];
const influenceMap = {1:{icon:'○',label:'Слабое'},2:{icon:'◔',label:'Ниже среднего'},3:{icon:'◑',label:'Среднее'},4:{icon:'◕',label:'Сильное'},5:{icon:'●',label:'Очень сильное'}};
let appState = null, currentTab = 'contacts', activeSectorId = null, activeMatrixPane = 'results', selectedTaskId = null, calendarDate = new Date(), saveInFlight = false;
let contacts = [], chats = [], currentChatId = null, editMode = false, selectedChats = new Set(), currentChatFilter = 'all';
let map = null, userMarker = null, userLatLng = null, currentCharacterSettings = { photoDataUrl: null, scale: 1, offsetX: 0, offsetY: 0, crystalEnabled: true };
let animationFrameId = null, currentRotationAngle = 0, photoImage = null, previewImage = null;
function uid(p){return `${p}_${Date.now()}_${Math.floor(Math.random()*1000)}`;}
function todayIso(){return new Date().toISOString().slice(0,10);}
function safeArray(v){return Array.isArray(v)?v:[];}
function escapeHtml(t){return String(t||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[m]);}
function getDefaultState(){
  const sec={}; sectorMeta.forEach(s=>sec[s.id]={title:s.title,score:5,matrix:{results:[],strategies:[],tactics:[],processProjects:[],owners:[],links:[]}});
  return {sectors:sec,influenceLevels:influenceMap,personality:{anthropometry:{heightCm:null,weightKg:null,chestCm:null,waistCm:null,hipsCm:null,neckCm:null,headCm:null,armLengthCm:null,legLengthCm:null,shoulderWidthCm:null,bmi:null},test:{responses:{},latestScore:null},analysisResults:[],alarms:[],characterSettings:{photoDataUrl:null,scale:1,offsetX:0,offsetY:0,crystalEnabled:true}},processes:{categories:['Регулярно-циклические','Нестандартные'],hierarchyTemplates:[],items:[]},tasks:[],readWithoutChecklist:[],contacts:[],chats:[],updatedAt:new Date().toISOString()};
}
function mergeState(st){const m={...getDefaultState(),...(st||{})}; m.sectors={...getDefaultState().sectors,...(st?.sectors||{})}; Object.keys(m.sectors).forEach(k=>{const mx=m.sectors[k].matrix||{}; m.sectors[k].matrix={results:safeArray(mx.results),strategies:safeArray(mx.strategies),tactics:safeArray(mx.tactics),processProjects:safeArray(mx.processProjects),owners:safeArray(mx.owners),links:safeArray(mx.links)};}); m.processes={...getDefaultState().processes,...(st?.processes||{}),categories:safeArray(st?.processes?.categories||getDefaultState().processes.categories),hierarchyTemplates:safeArray(st?.processes?.hierarchyTemplates||[]),items:safeArray(st?.processes?.items)}; m.tasks=safeArray(st?.tasks); m.readWithoutChecklist=safeArray(st?.readWithoutChecklist); m.personality={...getDefaultState().personality,...(st?.personality||{}),anthropometry:{...getDefaultState().personality.anthropometry,...(st?.personality?.anthropometry||{})},test:{...getDefaultState().personality.test,...(st?.personality?.test||{}),responses:{...(st?.personality?.test?.responses||{})}},analysisResults:safeArray(st?.personality?.analysisResults),alarms:safeArray(st?.personality?.alarms),characterSettings:{...getDefaultState().personality.characterSettings,...(st?.personality?.characterSettings||{})}}; m.contacts=safeArray(st?.contacts); m.chats=safeArray(st?.chats); return m;}
async function loadState(){try{const r=await fetch(stateEndpoint);const d=await r.json();appState=mergeState(d.state);}catch(e){appState=getDefaultState();}}
async function saveState(){if(!appState||saveInFlight)return;saveInFlight=true;try{await fetch(stateEndpoint,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({...appState,updatedAt:new Date().toISOString()})});}catch(e){}finally{saveInFlight=false;}}
function activateTab(tab){currentTab=tab;document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));document.getElementById(`panel-${tab}`).classList.add('active');document.querySelectorAll('.nav-item').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));if(tab==='tasks')renderTasks();if(tab==='analytics'){renderCalendar();runAnalytics();}if(tab==='contacts')renderContacts();if(tab==='chats')renderChatsList();if(tab==='settings'){const s=document.querySelector('.settings-subtab.active')?.dataset.subtab||'year';showSettingsSubtab(s);}}
function showSettingsSubtab(sub){document.querySelectorAll('.settings-pane').forEach(p=>p.classList.remove('active'));document.getElementById(`settings-${sub}`).classList.add('active');document.querySelectorAll('.settings-subtab').forEach(b=>b.classList.toggle('active',b.dataset.subtab===sub));if(sub==='year')renderYearTab();if(sub==='personality'){renderAnthroForm();renderTestForm();renderAnalysisResults();initAlarms();}if(sub==='processes'){renderProcessCategories();renderProcessTemplates();renderProcessItems();}}
function renderInfluenceLegend(){const b=document.getElementById('influenceLegendBody');b.innerHTML='';Object.entries(influenceMap).forEach(([l,i])=>{const r=document.createElement('tr');r.innerHTML=`<td>${i.label}</td><td>${i.icon} (${l})</td>`;b.appendChild(r);});}
function renderYearTab(){const c=document.getElementById('sectorCards');c.innerHTML='';sectorMeta.forEach(s=>{const mx=appState.sectors[s.id].matrix;const card=document.createElement('button');card.className='sector-card';card.innerHTML=`<strong>${s.title}</strong><div class="small">Результаты:${safeArray(mx.results).length} Стратегии:${safeArray(mx.strategies).length}</div><div class="badge">Связей:${safeArray(mx.links).length}</div>`;card.onclick=()=>openMatrix(s.id);c.appendChild(card);});}
function openMatrix(id){activeSectorId=id;activeMatrixPane='results';document.getElementById('matrixTitle').textContent=appState.sectors[id].title;document.getElementById('matrixModal').classList.add('active');renderMatrixTabs();renderMatrixPane();}
function closeMatrix(){activeSectorId=null;document.getElementById('matrixModal').classList.remove('active');renderYearTab();saveState();}
function renderMatrixTabs(){const t=document.getElementById('matrixTabs');t.innerHTML='';matrixPanesMeta.forEach(m=>{const b=document.createElement('button');b.textContent=m.label;b.classList.toggle('active',m.key===activeMatrixPane);b.onclick=()=>{activeMatrixPane=m.key;renderMatrixTabs();renderMatrixPane();};t.appendChild(b);});}
function addMatrixItem(key){if(!activeSectorId)return;const mx=appState.sectors[activeSectorId].matrix;if(key==='processProjects')mx.processProjects.push({id:uid(key),title:'',ownerId:''});else if(key==='owners')mx.owners.push({id:uid(key),name:''});else mx[key].push({id:uid(key),title:''});renderMatrixPane();}
function removeMatrixItem(key,id){const mx=appState.sectors[activeSectorId].matrix;const tgt=key==='processProjects'?'processProjects':key;mx[tgt]=mx[tgt].filter(i=>i.id!==id);mx.links=mx.links.filter(l=>l.fromId!==id&&l.toId!==id);renderMatrixPane();}
function renderEntityEditor(key,title,addLabel){const mx=appState.sectors[activeSectorId].matrix;const list=key==='processProjects'?mx.processProjects:key==='owners'?mx.owners:mx[key];const wrap=document.createElement('div');wrap.className='pane active';wrap.innerHTML=`<h3>${title}</h3><div class="list" id="list_${key}"></div><button class="btn" id="add_${key}">${addLabel}</button>`;const cont=wrap.querySelector(`#list_${key}`);list.forEach(it=>{const r=document.createElement('div');r.className='list-item';if(key==='processProjects'){r.innerHTML=`<input data-id="${it.id}" data-key="title" value="${escapeHtml(it.title||'')}" placeholder="Название"><select data-id="${it.id}" data-key="ownerId"><option value="">Исполнитель</option>${mx.owners.map(o=>`<option value="${o.id}" ${o.id===it.ownerId?'selected':''}>${escapeHtml(o.name)}</option>`)}</select><button class="btn warn" data-del="${it.id}">🗑</button>`;}else if(key==='owners'){r.innerHTML=`<input data-id="${it.id}" data-key="name" value="${escapeHtml(it.name||'')}" placeholder="ФИО"><button class="btn warn" data-del="${it.id}">🗑</button>`;}else{r.innerHTML=`<input data-id="${it.id}" data-key="title" value="${escapeHtml(it.title||'')}"><button class="btn warn" data-del="${it.id}">🗑</button>`;}cont.appendChild(r);});cont.querySelectorAll('input,select').forEach(f=>f.addEventListener('change',()=>{const idx=list.findIndex(i=>i.id===f.dataset.id);if(idx>=0)list[idx][f.dataset.key]=f.value;saveState();}));cont.querySelectorAll('[data-del]').forEach(b=>b.addEventListener('click',()=>removeMatrixItem(key,b.dataset.del)));wrap.querySelector(`#add_${key}`).onclick=()=>{addMatrixItem(key);saveState();};return wrap;}
function renderRelationsEditor(){const mx=appState.sectors[activeSectorId].matrix;const wrap=document.createElement('div');wrap.className='pane active';wrap.innerHTML=`<h3>Связи</h3><div class="form-row"><select id="relFromType"></select><select id="relFromId"></select><select id="relToType"></select><select id="relToId"></select><select id="relInfluence"></select><button class="btn" id="addRelationBtn">+</button></div><table class="relations-table"><thead><tr><th>От</th><th>К</th><th>Влияние</th><th></th></tr></thead><tbody id="relationsBody"></tbody></table>`;const fromT=wrap.querySelector('#relFromType'),toT=wrap.querySelector('#relToType'),fromId=wrap.querySelector('#relFromId'),toId=wrap.querySelector('#relToId'),inf=wrap.querySelector('#relInfluence');const pairs=[{from:'results',to:'strategies'},{from:'strategies',to:'tactics'},{from:'tactics',to:'processProjects'},{from:'tactics',to:'owners'},{from:'processProjects',to:'results'},{from:'processProjects',to:'owners'},{from:'owners',to:'results'}];fromT.innerHTML=[...new Set(pairs.map(p=>p.from))].map(t=>`<option>${t}</option>`).join('');function upd(){const allowed=pairs.filter(p=>p.from===fromT.value).map(p=>p.to);toT.innerHTML=allowed.map(t=>`<option>${t}</option>`).join('');const fn=mx[fromT.value]||[],tn=mx[toT.value]||[];fromId.innerHTML=fn.map(n=>`<option value="${n.id}">${n.title||n.name||'?'}</option>`).join('');toId.innerHTML=tn.map(n=>`<option value="${n.id}">${n.title||n.name||'?'}</option>`).join('');}inf.innerHTML=Object.entries(influenceMap).map(([l,d])=>`<option value="${l}">${d.icon}</option>`).join('');fromT.onchange=upd;toT.onchange=upd;upd();wrap.querySelector('#addRelationBtn').onclick=()=>{mx.links.push({id:uid('link'),fromType:fromT.value,fromId:fromId.value,toType:toT.value,toId:toId.value,influence:Number(inf.value)});renderMatrixPane();saveState();};const tbody=wrap.querySelector('#relationsBody');mx.links.forEach(l=>{const r=document.createElement('tr');r.innerHTML=`<td>${l.fromType} ${mx[l.fromType]?.find(i=>i.id===l.fromId)?.title||''}</td><td>${l.toType} ${mx[l.toType]?.find(i=>i.id===l.toId)?.title||''}</td><td><select data-rel="${l.id}">${Object.entries(influenceMap).map(([v,d])=>`<option value="${v}" ${Number(v)===l.influence?'selected':''}>${d.icon}</option>`)}</select></td><td><button class="btn warn" data-del="${l.id}">🗑</button></td>`;tbody.appendChild(r);});tbody.querySelectorAll('select').forEach(s=>s.addEventListener('change',()=>{const lk=mx.links.find(li=>li.id===s.dataset.rel);if(lk)lk.influence=Number(s.value);saveState();}));tbody.querySelectorAll('[data-del]').forEach(b=>b.addEventListener('click',()=>{mx.links=mx.links.filter(li=>li.id!==b.dataset.del);renderMatrixPane();saveState();}));return wrap;}
function renderMatrixPane(){const t=document.getElementById('matrixPanes');t.innerHTML='';if(!activeSectorId)return;if(activeMatrixPane==='results')t.appendChild(renderEntityEditor('results','Результаты','+ Результат'));else if(activeMatrixPane==='strategies')t.appendChild(renderEntityEditor('strategies','Стратегии','+ Стратегия'));else if(activeMatrixPane==='tactics')t.appendChild(renderEntityEditor('tactics','Тактика','+ Тактика'));else if(activeMatrixPane==='processProjects'){const d=document.createElement('div');d.appendChild(renderEntityEditor('processProjects','Процесс/Проект','+ Процесс'));d.appendChild(renderEntityEditor('owners','Исполнитель','+ Исполнитель'));t.appendChild(d);}else if(activeMatrixPane==='relations')t.appendChild(renderRelationsEditor());}
function renderAnthroForm(){const f=document.getElementById('anthroForm');const a=appState.personality.anthropometry;f.innerHTML='';['heightCm','weightKg','chestCm','waistCm','hipsCm'].forEach(k=>{f.innerHTML+=`<label>${k}<input data-key="${k}" type="number" value="${a[k]||''}"></label>`;});f.querySelectorAll('input').forEach(i=>i.addEventListener('change',()=>{a[i.dataset.key]=Number(i.value)||null;if(i.dataset.key==='heightCm'||i.dataset.key==='weightKg'){const h=a.heightCm,w=a.weightKg;a.bmi=h&&w?+(w/((h/100)**2)).toFixed(1):null;}saveState();}));}
function renderTestForm(){const q=['Саморегуляция','Стрессоустойчивость'];const c=document.getElementById('testForm');c.innerHTML='';q.forEach((t,i)=>{c.innerHTML+=`<div>${t}<input type="range" min="1" max="5" value="${appState.personality.test.responses[i]||3}" data-q="${i}"><span>${appState.personality.test.responses[i]||3}</span></div>`;});}
function renderAnalysisResults(){const l=document.getElementById('analysisList');l.innerHTML='';appState.personality.analysisResults.forEach(a=>{l.innerHTML+=`<div class="list-item">${a.name} ${a.value} <button data-id="${a.id}">🗑</button></div>`;});}
function initAlarms(){/* сокращённый рендер */ document.getElementById('alarm-list').innerHTML='<div>⏰ 07:00 Пн-Пт</div>';}
function renderProcessCategories(){const c=document.getElementById('processCategories');c.innerHTML=appState.processes.categories.map(cat=>`<span class="badge">${cat}</span>`).join('');}
function renderProcessTemplates(){document.getElementById('processTemplates').innerHTML='<div>Сон · Работа · Спорт</div>';}
function renderProcessItems(){document.getElementById('processItems').innerHTML='';}
function ensureTaskShape(t){return{id:t.id||uid('task'),title:t.title,date:t.date||todayIso(),sectorId:t.sectorId||'personal_growth',minutes:Number(t.minutes||30),influence:t.influence||3,checklist:safeArray(t.checklist),checklistDone:safeArray(t.checklistDone),status:t.status||'pending',reason:t.reason||''};}
function renderTasks(){const d=document.getElementById('taskDateFilter').value||todayIso();const tasks=appState.tasks.filter(t=>t.date===d);const c=document.getElementById('tasksContainer');c.innerHTML=tasks.map(t=>`<div class="task-item"><strong>${t.title}</strong> (${t.minutes} мин) <button data-id="${t.id}">✓</button></div>`).join('');}
function renderCalendar(){const y=calendarDate.getFullYear(),m=calendarDate.getMonth();document.getElementById('calendarMonthLabel').textContent=new Date(y,m).toLocaleDateString('ru',{month:'long',year:'numeric'});}
function runAnalytics(){document.getElementById('analyticsText').innerText=`Задач: ${appState.tasks.length}`;}
function startWeatherUpdates(){document.getElementById('weatherTemp').innerText='12°';}
function initInteractiveMap(){const m=L.map('map').setView([55.75,37.61],12);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(m);map=m;}
function initCharacterFromState(){}
function setupCharacterModal(){}
function renderContacts(){const c=document.getElementById('contactsList');c.innerHTML=contacts.map(ct=>`<div class="contact-item">${ct.firstName} ${ct.lastName}</div>`).join('');}
function renderChatsList(){document.getElementById('chatsList').innerHTML=chats.map(ch=>`<div class="chat-item">чат ${ch.id}</div>`).join('');}
function bindEvents(){
  document.querySelectorAll('.nav-item').forEach(b=>b.addEventListener('click',()=>activateTab(b.dataset.tab)));
  document.getElementById('syncNowBtn').onclick=saveState;
  document.getElementById('closeMatrixBtn').onclick=closeMatrix;
  document.querySelectorAll('.settings-subtab').forEach(b=>b.addEventListener('click',()=>showSettingsSubtab(b.dataset.subtab)));
  document.getElementById('addContactBtn').onclick=()=>document.getElementById('contactModal').classList.add('active');
  document.querySelectorAll('.close-modal-btn').forEach(b=>b.addEventListener('click',()=>b.closest('.modal').classList.remove('active')));
}
async function start(){await loadState();renderInfluenceLegend();bindEvents();activateTab('contacts');startWeatherUpdates();initInteractiveMap();}
start();
</script>
</body>
</html>
